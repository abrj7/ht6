# --- Person B fills this in ---
# Stay22 key from the hackathon sponsor booth / dashboard.
# Leave blank to run in mock mode (backend serves realistic fake Stay22 results
# so everyone else can build against the contract without a key).
STAY22_API_KEY=

PORT=4000

# Internal service URLs - defaults work for local dev, no changes needed.
AI_SERVICE_URL=http://localhost:5001
CHEXY_SERVICE_URL=http://localhost:5002

# Optional MongoDB URI for persisting user transactions (mongodb+srv://...)
MONGODB_URI=

# Auth0 configuration for JWT validation on protected spend routes.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ElevenLabs key for the voice concierge (leave blank to use the browser's
# built-in speech synthesis instead - everything still works without it).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
